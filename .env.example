# E2E test stand access. Copy to .env (git-ignored) and fill in. Details of every key: tests/e2e/README.md
# SSH by key only, no SSH passwords.

# comma-separated node hosts; the first one runs the suite (a cluster of two nodes for the migration tests)
NODES=
SSH_USER=root
# private key for SSH_USER (empty: the ssh default identity)
SSH_KEY=
# storage under test, a Pure Storage storage already defined in /etc/pve/storage.cfg
STORAGE_ID=
# where deploy.py puts the plugin on a node
PLUGIN_PATH=/usr/share/perl5/PVE/Storage/Custom/PureStoragePlugin.pm

# optional, passed to the Proxmox validation suite as is
# storage with the `backup` content that the backup tests use when the storage under test has none (e.g. local)
# PLUGIN_BACKUP_FALLBACK_STORAGE=local
# storage the disk and migration tests move a disk to (default: the first other enabled images storage of the node)
# PLUGIN_MIGRATION_TARGET_STORAGE=
# node the cluster migration tests migrate to (default: the first other online node)
# PLUGIN_MIGRATION_TARGET_NODE=
# guest image with the QEMU guest agent (default: a Debian cloud image downloaded and prepared on first use)
# PLUGIN_QGA_IMAGE=
# URL of an ISO for the download test (without it the test is skipped)
# PLUGIN_TEST_ISO_URL=

# optional, the extended tests with fio in a guest
# data disk size in GiB (default: twice the RAM of the node, 20 to 512)
# PLUGIN_LOAD_DISK_GB=
# guest disk controller (default virtio-scsi-single)
# PLUGIN_LOAD_SCSIHW=
# extra options of the data disk, e.g. cache=writeback,discard=on,iothread=1
# PLUGIN_LOAD_DISK_OPTIONS=
# GiB written with buffered writes before each migration (default 2, 0 turns it off)
# PLUGIN_LOAD_DIRTY_GB=
# rounds of volume_lifecycle_loop (default: one per guest controller)
# PLUGIN_LIFECYCLE_ROUNDS=
# root password of the guest image with fio, for a login on the console of a test guest
# PLUGIN_GUEST_PASSWORD=
